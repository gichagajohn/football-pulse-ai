# ============================================================
# FOOTBALL PULSE AI — Environment Configuration
# Copy this to .env and fill in your values
# ============================================================

# --- Football Data APIs (all free) ---
FOOTBALL_DATA_API_KEY=your_footballdata_org_key_here
THESPORTSDB_API_KEY=1          # "1" is the free public key

# --- Meta / Facebook & Instagram ---
FB_PAGE_ACCESS_TOKEN=your_facebook_page_access_token
FB_PAGE_ID=your_facebook_page_id
IG_USER_ID=your_instagram_business_user_id

# --- Optional: Grok AI (for AI-generated captions - leave blank to use templates) ---
# Free tier at https://x.ai/api — sign up with your X/Twitter account
# Model used: grok-3-mini (free)
GROK_API_KEY=

# --- App Settings ---
LOG_LEVEL=INFO
DB_PATH=database/football_pulse.db
OUTPUT_DIR=output
POSTER_DIR=output/posters
CAPTION_DIR=output/captions
TIMEZONE=UTC

# --- Scheduling ---
LIVE_CHECK_INTERVAL=60           # seconds
STANDINGS_CHECK_INTERVAL=900     # 15 minutes
FACTS_INTERVAL=3600              # 1 hour
HISTORICAL_INTERVAL=21600        # 6 hours

# --- Content Filters ---
MIN_PRIORITY_TO_POST=50          # 0-100; set higher to reduce volume
MAX_POSTS_PER_HOUR=6

# --- Duplicate Detection ---
DEDUPE_WINDOW_HOURS=48
